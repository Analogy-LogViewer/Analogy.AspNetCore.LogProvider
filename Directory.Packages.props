		<PackageVersion Include="Meziantou.Analyzer" Version="3.0.316" />
		<PackageVersion Include="Meziantou.Polyfill" Version="1.0.168" />
		<PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.9.0" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
		<PackageVersion Include="NLog.Web.AspNetCore" Version="6.2.2" />
		<PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
